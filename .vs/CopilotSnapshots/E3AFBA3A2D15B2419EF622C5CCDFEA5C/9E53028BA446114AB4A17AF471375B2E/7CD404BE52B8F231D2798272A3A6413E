};

// Constant buffer data
struct ConstantBufferData
{
	DirectX::XMFLOAT4X4					WorldViewProj;
	DirectX::XMFLOAT4					AmbientColor;
	DirectX::XMFLOAT4					FogColor;
	float									FogStart;
	float									FogEnd;
	float									Padding[2];
};

