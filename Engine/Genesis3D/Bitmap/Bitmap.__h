#ifndef GR_BITMAP____H
#define GR_BITMAP____H

#include "Bitmap.h"
#include "Bitmap._h"
#include "Wavelet.h"
#include "ThreadQueue.h"

// Hey ! 
// this is bitmap.__h : for inclusion by bitmap friends ONLY!
//	included by bitmap.c , bitmap_blitdata.c

/*}{ *********** the bitmap type *******************/

// the Version Major indicates an incompatibility

#define JEBM_VERSION_MAJOR		(0x0004)
#define JEBM_VERSION_MINOR		(0x0002)

	// version major 4 :
	// version minor 1 stored palettes in the hints
	// version minor 2 send the average color with the bitmaps

#define	MAXMIPLEVELS			(8)

#define PALETTE_FORMAT_DEFAULT	(GR_PIXELFORMAT_24BIT_RGB)

#define ALPHA_TO_TRANSPARENCY_THRESHOLD		(80)

struct grBitmap_Palette
{
	int32			LockCount,RefCount;
	grPixelFormat	Format;
	int32			Size;
	grBoolean		HasColorKey;
	uint32			ColorKey;		// the color which is the colorkey
	int32			ColorKeyIndex;	// the palette index which is the color;
									// Bitmap->CK == Bitmap->Pal->CK_Index

	// we have EITHER Data or DriverHandle
	void			*Data;		//Size * BytesPerPixel(Format)
	DRV_Driver		*Driver;
	grTexture		*DriverHandle;
	void			*DriverBits;	//only non-null inside a Lock/UnLock
};

typedef struct grBitmap
{
	int32 				RefCount;
	grBitmap_Info		Info;
	void *				Data[MAXMIPLEVELS];
	grBoolean			Modified[MAXMIPLEVELS];
							// modified tells whether a mip != a scaledown of mip 0
							// modified[0] is ignored
	grBitmap *			Alpha;

	int32				LockCount;	// -Nmips for 'write' , > 0 for 'read's
	grBitmap *			LockOwner;	// this points to our owner and doubles as boolean 'islocked'
	grBitmap *			DataOwner;	// if this is set, then my Data is not mine to free

	grPixelFormat		PreferredFormat;	// user's favorite
	int32				SeekMipCount;		// when we attach to driver, ask for this many mips

		// must support any number of locks for read
		// a lock for read can be a pointer to my raw bits, or a whole different bitmap

	grBitmap_Info		DriverInfo;			// all the driver mess..
	uint32				DriverFlags;
	DRV_Driver *		Driver;
	grTexture *	DriverHandle;
	int32				DriverMipBase;
	int32				DriverMipLock;		// which mip to lock on GetBits
	grBoolean			DriverBitsLocked;
	grBoolean			DriverDataChanged;	// relative to system copy
	grFloat				DriverGamma;
	grFloat				DriverGammaLast;
	grBoolean			DriverGammaSet;

	grWavelet *			Wavelet;
	int32				WaveletMipLock;
		// if Format == Wavelet, this is valid and Data & Alpha are NULL
		//  otherwise it is NULL
	grBoolean			HasWaveletOptions;
	grWavelet_Options	WaveletOptions;
	grBitmap_StreamingStatus StreamingStatus;
	grBoolean			StreamingTHandle;

	grBoolean			HasAverageColor;
	uint32				AverageR,AverageG,AverageB;

	grBoolean			Persistable;
	const grVFile *		PersistBaseFS;
	char				PersistName[1024];
} grBitmap;


/*}{ ************* internal protos *****************/

//grBitmap * grBitmap_CreateXerox(grBitmap *BmpSrc);

grBoolean grBitmap_IsValid(const grBitmap *Bmp);
grBoolean grBitmap_Info_IsValid(const grBitmap_Info *Info);
grBoolean grBitmap_Palette_IsValid(const grBitmap_Palette *Pal);

grBoolean grBitmap_BlitMipRect(const grBitmap * Src, int32 SrcMip, int32 SrcX,int32 SrcY,
									 grBitmap * Dst, int32 DstMip, int32 DstX,int32 DstY,
							int32 SizeX,int32 SizeY);

grBitmap * grBitmap_CreateLock_CopyInfo(grBitmap *BmpSrc,int32 LockCnt,int32 mip);
grBitmap * grBitmap_CreateLockFromMip(grBitmap *Src,int32 mip,
	grPixelFormat Format,grBoolean HasColorKey,uint32 ColorKey,int32 LockCnt);
grBitmap * grBitmap_CreateLockFromMipSystem(grBitmap *Src,int32 mip,int32 LockCnt);
grBitmap * grBitmap_CreateLockFromMipOnDriver(grBitmap *Src,int32 mip,int32 LockCnt);

grBoolean grBitmap_UnLock_NoChange(grBitmap *Bmp);
grBoolean grBitmap_UnLockArray_NoChange(grBitmap **Locks,int32 Size);

grBoolean grBitmap_Update_SystemToDriver(grBitmap *Bmp);
grBoolean grBitmap_Update_DriverToSystem(grBitmap *Bmp);

grBoolean grBitmap_MakeSystemMips(grBitmap *Bmp,int32 low,int32 high);
grBoolean grBitmap_UpdateMips_Data(	grBitmap_Info * FmInfo,void * FmBits,
									grBitmap_Info * ToInfo,void * ToBits);
grBoolean grBitmap_UpdateMips_System(grBitmap *Bmp,int32 fm,int32 to);

grBoolean grBitmap_UsesColorKey(const grBitmap * Bmp);

void	  grBitmap_MakeMipInfo(  grBitmap_Info *Src,int32 mip,grBitmap_Info *Into);
grBoolean grBitmap_MakeDriverLockInfo(grBitmap *Bmp,int32 mip,grBitmap_Info *Into);
					// MakeDriverLockInfo also doesn't full out the full info, so it must be a valid info first!
					// Bmp also gets some crap written into him.

grBoolean grBitmap_AllocSystemMip(grBitmap *Bmp,int32 mip);
grBoolean grBitmap_AllocPalette(grBitmap *Bmp,grPixelFormat Format,DRV_Driver * Driver);

grBoolean grBitmap_ReadInfo( grBitmap *Bmp,grVFile * F);
grBoolean grBitmap_WriteInfo(const grBitmap *Bmp,grVFile * F);

grBoolean grBitmap_WaitForUnLock(const grBitmap *Bmp);
grBoolean grBitmap_WaitReady(const grBitmap *Bmp);
grBoolean grBitmap_PeekReady(const grBitmap *Bmp);

grBoolean			grBitmap_FixDriverFlags(uint32 *pFlags);

/*}{ ************* end *****************/

#endif
