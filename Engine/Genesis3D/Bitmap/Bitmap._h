#ifndef BITMAP_PRIVATE_H
#define BITMAP_PRIVATE_H

#include	"Bitmap.h"
#include	"Dcommon.h"

#ifdef __cplusplus
extern "C" {
#endif

/***
**
*
* These functions are intended for internal Jet3D use only.
* This can become public once Driver is exposed.
*
* Only engine.c , and maybe world & bitmaplist should include this !
*
*
* You MUST DetachDriver from a bitmap, before you change the Driver
*
**
 **/

#define BITMAP_GR_INTERNAL	GRCC

grBoolean			GRCC grBitmap_AttachToDriver(grBitmap *Bmp, DRV_Driver * Driver, uint32 DriverFlags);
	// use Driverflags == 0 to use the flags from _SetDriverFlags

grBoolean			GRCC grBitmap_DetachDriver(grBitmap *Bmp, grBoolean DoUpdate);
	// You MUST Detach the Driver while it is identical to the way it was when attached!

grBitmap_Palette *	GRCC grBitmap_Palette_CreateFromDriver(DRV_Driver * Driver,grPixelFormat Format,int32 Size); /*<>*/

grTexture * GRCC grBitmap_GetTHandle(const grBitmap *Bmp);

grBoolean BITMAP_GR_INTERNAL grBitmap_SetDriverFlags(grBitmap *Bmp,uint32 Flags);

grBoolean			GRCC grBitmap_SetGammaCorrection_DontChange(grBitmap *Bmp,grFloat Gamma);

#ifdef __cplusplus
}
#endif


#endif // BITMAP_PRIVATE_H
