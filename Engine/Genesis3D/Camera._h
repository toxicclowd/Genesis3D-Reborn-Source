#ifndef JECAMERA_INTERNAL_H
#define JECAMERA_INTERNAL_H

#include "BaseType.h"
#include "Vec3d.h"
#include "Xform3d.h"
#include "grTypes.h"

#include "List.h"

#ifdef __cplusplus
extern "C" {
#endif

typedef struct grCamera 
{
	grFloat		FovRadians;					// Field of View for Camera
	grFloat		Width;						// Width of viewport
	grFloat		Height;						// Height of viewport
	grFloat		Left,Right,Top,Bottom;		// Clipping rect

	grFloat		Scale;						// X and Y Scale based on Fov
	grFloat		XCenter;					// Screen Width/2
	grFloat		YCenter;					// Screen Height/2

	grXForm3d	XForm;						// View transform

	grXForm3d	TransposeXForm;				// Original World xform...
	
	grVec3d		Pov;						// Un rotated Pov in XForm

	// the camera points along Z in camera space,
	// these trigs define the viewing pyramid frustum
	grFloat		SinViewAngleX;				
	grFloat		CosViewAngleX;				
	grFloat		SinViewAngleY;				
	grFloat		CosViewAngleY;				
	
	Stack		*XFormStack;

	grFloat		ZScale;						// Z Project scalar
	
	// BEGIN - Far clip plane - paradoxnj 2/9/2005
	grBoolean	ZFarEnable;
	grFloat		ZFar;
	// END - Far clip plane - paradoxnj 2/9/2005
} grCamera;

// foward definition
void	GRCF grCamera_GetWidthHeight(const grCamera *Camera,grFloat *Width,grFloat *Height);
float	GRCF grCamera_GetScale(const grCamera *Camera);

const grXForm3d *		GRCF grCamera_XForm( const grCamera *Camera);
const grXForm3d *		GRCF grCamera_WorldXForm( const grCamera *Camera);
const grVec3d *		GRCF grCamera_GetPov(const grCamera *Camera);
void  grCamera_FillDriverInfo(grCamera *Camera);

void GRCF grCamera_GetViewAngleXSinCos( const grCamera *Camera, grFloat *SinAngle, grFloat *CosAngle );
void GRCF grCamera_GetViewAngleYSinCos( const grCamera *Camera, grFloat *SinAngle, grFloat *CosAngle );

//-----------------------------------------------------

#ifdef __cplusplus
}
#endif

#endif
