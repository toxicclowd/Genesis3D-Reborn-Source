#ifndef GR_TERRAIN_INTERNAL_H
#define GR_TERRAIN_INTERNAL_H

typedef struct grTerrain_Light	grTerrain_Light;

#include "Terrain.h"
#include "Quad.h"
#include "grProperty.h"
#include "grMaterial.h"

/*}{******************************************************/
//	grTerrain struct

typedef enum 
{
	TERRAIN_LIGHT_SUN,		// Vector points to the sun
	TERRAIN_LIGHT_SUN_SOFT,	// Vector points to the sun ; soft shadows
	TERRAIN_LIGHT_SPHERE,	// Vector is the location of the light
								// the Radius-squared of a sphere light is just the Color !!!
	TERRAIN_LIGHT_FLAT,		// no vector; just applies the color everywhere
} grTerrain_LightType;

struct grTerrain_Light
{
	grTerrain_LightType	Type;
	grVec3d				Vector;
	grRGBA				Color;
	grFloat				MaxColor;	// = max(Color.r,Color.g,Color.b) , computed by grTerrain
};

#define TERRAIN_MAX_NUM_LIGHTS	(128)
#define MAX_TEXDIM_LOG2		(3)
#define MAX_TEXDIM		(1<<MAX_TEXDIM_LOG2)
#define MAX_TEXTURES		(MAX_TEXDIM*MAX_TEXDIM)

struct grTerrain
{
	int RefCount;

	int HMWidth,HMHeight;
	float * HM;
	grXForm3d XFTerrainToWorld,XFWorldToTerrain;
	grVec3d CubeSize,InvCubeSize,Size;

	uint32 MaxQuads;
	float  MinError;

	QuadTree * QT;

	grVec3d LastTesselatedCameraPos;
	grVec3d LastTesselatedCameraVec;
	
	int32	NumDynamicLights;
	grTerrain_Light DynamicLights[TERRAIN_MAX_NUM_LIGHTS];

	grBoolean Changed;

	grProperty_List * PropertyList;
	grBitmap * Heightmap;
	char HeightmapName[1024];

	grWorld * World;	
	grEngine * Engine;

	grBoolean TexturesAreLit;
	grBitmap * Textures[MAX_TEXTURES];

	grBitmap * PreLightTextures[MAX_TEXTURES];
	grBoolean	RegisteredTexture[MAX_TEXTURES];
	int TexDim;

	grMaterialSpec* NullMaterial;			// Krouer: start support of grMaterialSpec
	grBitmap *NullTexture;
	grBitmap *HiliteTexture;

	grTerrain * SelfCheck;

	grBoolean Untouchable;
	
	grBoolean	HasSelection;
	grFloat		SelectionX,SelectionY;
	int			SelectionTexX,SelectionTexY;
	
	int			LightListSel;

	grBoolean   RenderNextFlag;
};

#endif // GR_TERRAIN_INTERNAL_H
