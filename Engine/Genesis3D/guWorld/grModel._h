/* Krouer: add BSP proxy structure to handle different kind of BSP implementation */
typedef struct BSP_Proxy
{
	grBSP* (*Create)();
	void  (*Destroy)(grBSP **BSPTree);
	grBSP* (*RebuildGeometry)(grBSP *BSP, grChain *BrushChain, grBSP_Options Options, grBSP_Logic Logic, grBSP_LogicBalance LogicBalance);
	grBoolean (*SetArrays)(grBSP *BSP, grFaceInfo_Array *FArray, grMaterial_Array *MArray, grChain *LChain, grChain *DLChain);
	grBoolean (*AddBrush)(grBSP *BSPTree, grBrush *Brush, grBoolean AutoLight);
	grBoolean (*HasBrush)(grBSP *BSPTree, grBrush *Brush);
	grBoolean (*RemoveBrush)(grBSP *BSPTree, grBrush *Brush);
	grBoolean (*MakeVisAreas)(grBSP *BSPTree);
	grBoolean (*DestroyVisAreas)(grBSP *BSP);
	grBoolean (*AddObject)(grBSP *BSP, grObject *Object);
	grBoolean (*RemoveObject)(grBSP *BSP, grObject *Object);
	grBoolean (*HasObject)(grBSP *BSP, grObject *Object);
	grBoolean (*VisFrame)(grBSP *BSPTree, const grCamera *Camera, const grFrustum *ModelSpaceFrustum);
	grBoolean (*RenderFrontToBack)(grBSP *Tree, grCamera *Camera, grFrustum *CameraSpaceFrustum, grFrustum *ModelSpaceFrustum, grXForm3d *ModelToCameraXForm);
	grBoolean (*RenderAndVis)(grBSP *Tree, grCamera *Camera, grFrustum *Frustum);
	grBoolean (*RenderAreas)(grBSP *Tree, grCamera *Camera, grFrustum *CameraSpaceFrustum, grFrustum *ModelSpaceFrustum, grXForm3d *ModelToCameraXForm);
	grBoolean (*UpdateBrush)(grBSP *BSPTree, grBrush *Brush, grBoolean AutoLight);
	grBoolean (*UpdateBrushFace)(grBSP *BSP, const grBrush_Face *Face, grBoolean AutoLight);
	grBoolean (*PatchLighting)(grBSP *Tree);
	grBoolean (*RebuildLights)(grBSP *Tree);
	grBoolean (*RebuildLightsFromPoint)(grBSP *Tree, const grVec3d *Pos, grFloat Radius);
	grBoolean (*UpdateAll)(grBSP *BSP);
	grBoolean (*RebuildFaces)(grBSP *BSPTree);
	grBoolean (*SetBrushFaceCB)(grBSP *BSP, grBSPNode_DrawFaceCB *CB, void *Context);
	grBoolean (*SetBrushFaceCBOnOff)(grBSP *BSP, const grBrush_Face *Face, grBoolean OnOff);
	grBoolean (*SetXForm)(grBSP *BSP, const grXForm3d *XForm);
	grBoolean (*SetEngine)(grBSP *Tree, grEngine *Engine);
	grBoolean (*SetWorld)(grBSP *Tree, grWorld *World);
	grBoolean (*SetRenderMode)(grBSP *BSP, grBSP_RenderMode RenderMode);
	grBoolean (*SetDefaultContents)(grBSP *BSP, grBrush_Contents DefaultContents);
	grBSPNode_Area* (*FindArea)(grBSP * BSP, const grVec3d *Pos);
	grBoolean (*DoAllAreasInBox)(grBSP *BSP,grExtBox *BBox,grBSP_DoAreaFunc CB,void * Context);
	grBoolean (*GetModelSpaceBox)(const grBSP *BSP, grExtBox *Box);
	grBoolean (*GetWorldSpaceBox)(const grBSP *BSP, grExtBox *Box);
	grBoolean (*Collision)(const grBSP *BSP, const grExtBox *Box, const grVec3d *Front, const grVec3d *Back, grVec3d *Impact, grPlane *Plane);
	grBoolean (*ChangeBoxCollision)(const grBSP *BSP, const grVec3d *Pos, const grExtBox *FrontBox, const grExtBox *BackBox, grExtBox *ImpactBox, grPlane *Plane);
	grBoolean (*RayIntersectsBrushes)(const grBSP *BSP, const grVec3d *Front, const grVec3d *Back, grBrushRayInfo *Info);
	const grBSP_DebugInfo* (*GetDebugInfo)(const grBSP *BSPTree);
} BSP_Proxy;

#ifdef __cplusplus
}
#endif

#endif
