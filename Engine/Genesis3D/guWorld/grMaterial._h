#ifndef GR_MATERIAL__H
#define GR_MATERIAL__H

#include "grMaterial.h"
#include "Engine.h"
#include "XForm3d.h"

#ifdef __cplusplus
extern "C" {
#endif

#define GR_MATERIAL_MAX_LAYER	32

typedef struct grShader grShader;
typedef struct grEngine grEngine;
typedef struct grResourceMgr grResourceMgr;
//=======================================================================================
//	
//=======================================================================================
// Krouer: add a specification of a layer
typedef struct grMaterialSpec_Layer
{
	char Name[GR_MATERIAL_MAX_NAME_SIZE];
	grXForm3d XForm;
	union {
		grTexture* pTexture;
		grBitmap*  pBitmap;
	};
	uint16 Kind;
	uint8 Type;
	uint8 UVMapID;
} grMaterialSpec_Layer;

// Add a specification of a material (multilayered or not)
typedef struct grMaterialSpec
{
	uint32 RefCnt;
	uint16 Flags;
	int16  LayerCounts;
	grRGBA Diffuse;
	grRGBA Specular;
	grRGBA Ambient;
	grRGBA Emissive;
	grShader* pShader;
	grMaterialSpec_Layer* pLayers[GR_MATERIAL_MAX_LAYER];
	grEngine* pEngine;
	grMaterialSpec_Thumbnail* pThumbnail;
	uint16 Width;
	uint16 Height;
} grMaterialSpec;

//=======================================================================================
//	Function prototypes
//=======================================================================================
grBoolean grMaterial_ArraySetEngine(grMaterial_Array *Array, grEngine *Engine);

#ifdef __cplusplus
}
#endif

#endif
