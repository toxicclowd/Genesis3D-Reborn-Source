#ifndef	VFILE__H
#define VFILE__H

#include	"BaseType.h"
#include	"VFile.h"

#define	GR_VFILE_HINTSFILEHEADER_SIGNATURE	(0x48484656)	// "VFHH"

typedef	struct	grVFile_HintsFileHeader
{
	unsigned long	Signature;
	unsigned int	HintDataLength;
}	grVFile_HintsFileHeader;


typedef void * 		(GRCC *grVFile_FinderCreateFN)(grVFile *FileSystem, void *Handle, const char *FileSpec);
typedef grBoolean 	(GRCC *grVFile_FinderGetNextFileFN)(void *Handle);
typedef grBoolean 	(GRCC *grVFile_FinderGetPropertiesFN)(void *Handle, grVFile_Properties *Properties);
typedef void 		(GRCC *grVFile_FinderDestroyFN)(void *Handle);

typedef	void * 	(GRCC *grVFile_OpenNewSystemFN)(grVFile *FS,
					 const char *Name,
					 void *	Context,
					 unsigned int OpenModeFlags);

typedef grBoolean (GRCC *grVFile_UpdateContextFN)(grVFile *FS, void *Handle, void *Context, int ContextSize);

typedef	void * 	(GRCC *grVFile_OpenFN)(grVFile *FS,
					 void *Handle,
					 const char *Name,
					 void *	Context,
					 unsigned int OpenModeFlags);

typedef	grBoolean  (GRCC *grVFile_DeleteFileFN)(grVFile *FS, void *Handle, const char *FileName);
typedef	grBoolean  (GRCC *grVFile_RenameFileFN)(grVFile *FS, void *Handle, const char *FileName, const char *NewFileName);
typedef	grBoolean  (GRCC *grVFile_FileExistsFN)(grVFile *FS, void *Handle, const char *FileName);
typedef	grBoolean  (GRCC *grVFile_DisperseFN)(grVFile *FS, void *Handle, const char *Directory);
typedef	grBoolean  (GRCC *grVFile_CloseFN)(void *Handle);

typedef	grBoolean  (GRCC *grVFile_GetSFN)(void *Handle, void *Buff, int MaxSize);
typedef	grBoolean  (GRCC *grVFile_BytesAvailableFN)(void *Handle, long *Count);
typedef	grBoolean  (GRCC *grVFile_ReadFN)(void *Handle, void *Buff, uint32 Count);
typedef	grBoolean  (GRCC *grVFile_WriteFN)(void *Handle, const void *Buff, int Count);
typedef	grBoolean  (GRCC *grVFile_SeekFN)(void *Handle, int Where, grVFile_Whence Whence);
typedef	grBoolean  (GRCC *grVFile_EOFFN)(const void *Handle);
typedef	grBoolean  (GRCC *grVFile_TellFN)(const void *Handle, long *Position);
typedef	grBoolean  (GRCC *grVFile_GetPropertiesFN)(const void *Handle, grVFile_Properties *Properties);

typedef	grBoolean  (GRCC *grVFile_SizeFN)(const void *Handle, long *Size);
typedef grBoolean  (GRCC *grVFile_SetSizeFN)(void *Handle, long Size);
typedef grBoolean  (GRCC *grVFile_SetAttributesFN)(void *Handle, grVFile_Attributes Attributes);
typedef grBoolean  (GRCC *grVFile_SetTimeFN)(void *Handle, const grVFile_Time *Time);

typedef grVFile *  (GRCC *grVFile_GetHintsFileFN)(void *Handle);

typedef	struct	grVFile_SystemAPIs
{
	grVFile_FinderCreateFN		FinderCreate;
	grVFile_FinderGetNextFileFN	FinderGetNextFile;
	grVFile_FinderGetPropertiesFN	FinderGetProperties;
	grVFile_FinderDestroyFN		FinderDestroy;

	grVFile_OpenNewSystemFN		OpenNewSystem;
	grVFile_UpdateContextFN		UpdateContext;
	grVFile_OpenFN				Open;
	grVFile_DeleteFileFN		DeleteFile;
	grVFile_RenameFileFN		RenameFile;
	grVFile_FileExistsFN		FileExists;
	grVFile_DisperseFN			Disperse;
	grVFile_CloseFN				Close;

	grVFile_GetSFN				GetS;
	grVFile_BytesAvailableFN	BytesAvailable;
	grVFile_ReadFN				Read;
	grVFile_WriteFN				Write;
	grVFile_SeekFN				Seek;
	grVFile_EOFFN				Eof;
	grVFile_TellFN				Tell;
	grVFile_SizeFN				Size;

	grVFile_GetPropertiesFN		GetProperties;

	grVFile_SetSizeFN			SetSize;
	grVFile_SetAttributesFN		SetAttributes;
	grVFile_SetTimeFN			SetTime;

	grVFile_GetHintsFileFN		GetHintsFile;

}	grVFile_SystemAPIs;

grBoolean GRCC VFile_RegisterFileSystem(
	const grVFile_SystemAPIs *	APIs,
	grVFile_TypeIdentifier *		Type);

#endif
