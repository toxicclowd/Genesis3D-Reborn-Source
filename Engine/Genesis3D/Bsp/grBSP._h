grBoolean	grBSP_BrushSubtract(grBSP_Brush *a, grBSP_Brush *b, grBSP *BSP, grBSP_Brush **Result);
grBSP_Brush *grBSP_BrushCSGList(grBSP_Brush *List, grBSP *BSP);

