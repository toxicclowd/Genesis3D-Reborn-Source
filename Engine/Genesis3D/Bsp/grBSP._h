#define MAX_TEMP_VERTS		128

extern void LogOut(const char *Str, ...);

extern grWorld_DebugInfo		g_WorldDebugInfo;

#ifdef __cplusplus
extern "C" {
#endif

#define ZeroMem(a) memset(a, 0, sizeof(*a))
#define ZeroMemArray(a, s) memset(a, 0, sizeof(*a)*s)

#define GR_BSP_MINMAX_BOUNDS		9999.0f
#define GR_BSP_TINY_AREA			0.1f
#define GR_BSP_TINY_VOLUME			0.5f
#define GR_BSP_PLANESIDE_EPSILON	0.001f
#define GR_BSP_ON_EPSILON			0.05f

#define BSP_UPDATE_FACES			(1<<0)
#define BSP_UPDATE_LIGHTS			(1<<1)

#define LGRID_SIZE					16.0f
#define MAX_LIGHTMAP_WH				18			// Max Width/Height
#define MaxLight					255.0f		// To allow for overbright dlights
#define RadiusScale					1.0f
#define LightScale					1.0f

typedef struct
{
	grVec3d		Pos;
	grFloat		Radius;
	grVec3d		Color;
	int32		R, G, B;
	uint32		Flags;
} grBSPNode_Light;

// grBSP is the heart and soul object.  It is the BSPTree.
typedef struct grBSP
{
	grExtBox				Box;			// Box of entire tree (In original bsp space)
	grExtBox				WorldSpaceBox;

	uint32					UpdateFlags;

	grBSPNode				*RootNode;		// Top level node of tree
	grBSPNode				*OutsideNode;	// This is the outside node, for flood filling

	// These arrays are	inherited from the bsp's parent
	grFaceInfo_Array		*FaceInfoArray;
	grMaterial_Array		*MaterialArray;
	grChain					*LightChain;		// Chain of grBSPNode_Lights
	grChain					*DLightChain;

	// grBSP owns these	arrays:
	grPlaneArray			*PlaneArray;
	grVertArray				*VertArray;
	grTexVec_Array			*TexVecArray;
	grArray					*NodeArray;
	grArray					*DrawFaceArray;

	uint32					NumBrushes;
	grBSP_TopBrush			*TopBrushes;

	int32					NumDLights;
	grBSPNode_Light			DLights[MAX_VISIBLE_DLIGHTS];		// Dynamic light stack
	uint32					DLightVisFrame;

	grBSPNode_DrawFaceCB	*DrawFaceCB;
	void					*DrawFaceCBContext;

	grBSP_RenderMode		RenderMode;
	grBrush_Contents		DefaultContents;

	grEngine				*Engine;
	DRV_Driver				*Driver;			// Current rendering driver the engine is using
	grEngine_ChangeDriverCB	*ChangeDriverCB;

	grBSP_DebugInfo			DebugInfo;

	grXForm3d				ModelToWorldXForm;
	grXForm3d				WorldToModelXForm;

	int32					RenderRecursion;

	grChain					*BSPObjectChain;

	grChain					*AreaChain;			// Linked list of all areas (NULL if none)
#ifdef AREA_DRAWFACE_TEST
	LinkNode				LeafList;
#endif

	grChain					*RenderDataList;  // The grRenderSectionData array - added by Krouer
	grChain					*FacesPerMaterialList; // The sort of faces per material - added by Krouer

	grWorld					*World; //The world object (added by cyrius) (if we can ever figure out how to set it!)

	grVertexBuffer			*pVertexBuffer;
	grIndexBuffer			*pIndexBuffer;
} grBSP;

typedef struct 
{
	grCamera				*Camera;
	grXForm3d				ModelToCameraXForm;
	grVec3d					POV;
	grFrustum				*Frustum;
	uint32					RecursionBit;

	uint32					DefaultRenderFlags;
} grBSPNode_SceneInfo;

typedef struct
{
	grObject		*Object;
	grBSPNode_Area	*Area;		// Area the object occupies (NOTE - Objects can only occupy one area at a time)
} grBSP_Object;

typedef struct 
{
	grBSP					*BSP;
	grBSPNode_DrawFace		*DFace;
} grBSPNode_DrawFaceRenderCB;

typedef uint8			grBSP_SideFlag;

// grBSP_Side flags
#define SIDE_VISIBLE		(1<<0)
#define SIDE_TESTED			(1<<1)
#define SIDE_HINT			(1<<2)	
#define SIDE_NODE			(1<<3)		// Side used as a node in the teee 
#define SIDE_VIS_PORTAL		(1<<4)		// Side is a vis portal
#define SIDE_SHEET			(1<<5)
#define SIDE_SKIP			(1<<6)
#define SIDE_SPLIT			(1<<7)		// Side was a result of a brush being split

// Sides are what grBSP_Brushes use to link polys.  
typedef struct grBSP_Side
{
	grPoly					*Poly;
	grPlaneArray_Index		PlaneIndex;
	grBSP_SideFlag			Flags;

} grBSP_Side;

#define GR_BSP_BRUSH_DEFAULT_SIDES		6

#define BSPBRUSH_FORCEBOTH				(1<<0)

// grBSP_Brushes are the brushes that get cut up to make the tree
typedef struct grBSP_Brush
{
	grBSP_TopBrush		*Original;		// Original top level grBSPBrush
	grBSP_Brush			*Next;
	grExtBox			Box;			// Box of brush

	uint8				Flags;

	grPlane_Side		Side;			// Side of node during construction
	grPlane_Side		TestSide;

	uint16				NumSides;
	grBSP_Side			Sides[GR_BSP_BRUSH_DEFAULT_SIDES];

} grBSP_Brush;

#define TOPSIDE_UPDATE_LIGHT			(1<<0)		// This side need to have light re-built
#define TOPSIDE_CALL_CB					(1<<1)		// DrawFaces resulting from topside should call CB func

typedef struct grBSP_TopSide
{
	grPlaneArray_Index		PlaneIndex;
	grFaceInfo_ArrayIndex	FaceInfoIndex;
	grTexVec_ArrayIndex		TexVecIndex;
	grBSP_SideFlag			Flags;

	uint8					TopSideFlags;

	grBrush_Face			*grBrushFace;		// grBrush_Face that created this TopSide
} grBSP_TopSide;

// grBSP_TopBrushes are the toplevel brushes, that BSPBrushes are built from
// grBSP_TopBrushes are the convex volumes, that make up grBrushes...
// Once a TopBrush is created froma grBrush, there is no more dependencies on grBrush...
typedef struct grBSP_TopBrush
{
	grBSP_TopBrush		*Next;
	grBrush				*Original;		// Editor brush that this top brush was created from

	grBrush_Contents	Contents;
	uint32				Order;			// Order that brush was put in list

	uint16				NumSides;
	grBSP_TopSide		TopSides[GR_BSP_BRUSH_DEFAULT_SIDES];

} grBSP_TopBrush;

//================================================================================
//					*** grBSPNode ***
//================================================================================
typedef struct		grBSPNode_Leaf		grBSPNode_Leaf;
typedef struct		grBSPNode_Area		grBSPNode_Area;

// Node children index defines
#define NODE_FRONT		0
#define NODE_BACK		1

// grBSPNode flags
#define NODE_DETAIL			(1<<0)		// NODE_DETAIL and NODE_LEAF are mutually exclusive
#define NODE_LEAF			(1<<1)		// Node is a leaf (Leaf member will be valid)
#define NODE_OUTSIDE		(1<<2)		// Node is in the outside area
#define NODE_REBUILD_FACES	(1<<3)		// Node got new BSP faces, needs to merge/split, make drawfaces, etc...
#define NODE_UPDATELIGHTS	(1<<4)		// Node got new BSP faces, needs to relight

#define GR_BSP_MAX_DRAW_FACES	65535	// (~(uint32))

#define grpBSPNode_DrawFace		grBSPNode_DrawFace*

/*!	
	a grBSPNode seperates 2 halfspaces.  When no more nodes are available,
	the node is a leaf...
*/
typedef struct grBSPNode
{
	// Info about a node as a node only
	struct grBSPNode	*Parent;		//<! Parent of this node (NULL if this is the RootNode)
	struct grBSPNode	*Children[2];	//<! Front and back child (FRONT_NODE/BACK_NODE)

	uint8				Flags;		
	grExtBox			Box;			//<! Box of node, and all its children
	grPlaneArray_Index	PlaneIndex;		//<! PlaneIndex 
	grBSPNode_Face		*Faces;

	uint16				NumDrawFaces;	//<! Number of draw faces
	grpBSPNode_DrawFace	*DrawFaces;		//<! Array of DrawFaces

	grBSP_Side			*Side;			//<! The Side that this node used to split all other brushes
	grBSP_Brush			*Volume;		//<! Current volume of node

	// Info about a node as a node, and leaf
	// (portals are on nodes temporally, until they get distributed to the leafs)
	grBSPNode_Portal	*Portals;		//<! Portals that bound the leaf 

	uint32				RecursionBits;	//<! If Leaf/Node visible this recursion level, recursion bit will be set

	// Info about a node as a leaf only
	grBSPNode_Leaf		*Leaf;			//<! Extra info, when a node is a leaf

} grBSPNode;

typedef struct
{
	grBoolean		HitSet;
	grPlane			*Plane;
	grVec3d			*Impact;
} grBSPNode_CollisionInfo;

typedef struct
{
	grBoolean		HitSet;
	grBoolean		HitLeaf;
	grFloat			BestDist;

	const grVec3d	*Front;
	grVec3d			*Impact;
	grPlane			*Plane;
} grBSPNode_CollisionInfo2;

typedef struct	// Added by Icestorm
{
	grBoolean		HitSet;
	grBoolean		HitLeaf;
	grFloat			BestDist;

	const grExtBox	*FrontBox;
	grExtBox		*ImpactBox;
	grPlane			*Plane;
} grBSPNode_CollisionInfo3;

// Portal flags
#define PORTAL_SIDE_FOUND		(1<<0)		// Side was found for a portal

typedef struct grBSPNode_Portal
{
	uint8				Flags;

	grPoly				*Poly;				// Convex poly that holds the shape of the portal
	grBSPNode			*Nodes[2];			// Node on each side of the portal
	grBSPNode_Portal	*Next[2];			// Next portal for each node
	grPlaneArray_Index	PlaneIndex;

	grBSPNode			*OnNode;			// Node that created this portal

	grBSPNode_Face		*Face[2];			// Face on each side of the portal
	grBSP_TopSide		*Side;				// TopSide that portal maps too
} grBSPNode_Portal;

// Face flag defs
#define BSPFACE_MERGED_SPLIT				(1<<0)	// NOT an original face in the list.  This face was produced by split/merge
#define BSPFACE_SPAN_MULTIPLE_BRUSH_FACES	(1<<1)	// Face was merged accross multiple brush faces

// grBSPNode_Faces are put on the visible portals
typedef struct grBSPNode_Face
{
	grBSPNode_Face			*Next;		// Next face in the list
	grPoly					*Poly;		// Poly that defines the winding of vertices for the face
	uint8					Flags;		// FaceFlags
	grBrush_Contents		Contents;	// Contents of the leaf that the face looks into

	grPlaneArray_Index		PlaneIndex;

	grBSPNode_Portal		*Portal;	// Portal that created the face

	grBSPNode_Face			*Split[2];	// If face was split, this is the resulting 2 faces
	grBSPNode_Face			*Merged;	// If merged with another face, this is the resulting face

	grBSPNode_DrawFace		*DrawFace;	// DrawFace that was created off this BSPFace (it also looks at the BSPFace)

	uint8					TopSideFlags;	// These flags are inherited from TopSides

} grBSPNode_Face;

typedef struct
{
	float				u, v;
	float				r, g, b;			// Should these be shared as well???
} grTexVert;

#define GR_LIGHTMAP_MAX_STYLES			4

typedef struct grBSPNode_Lightmap
{
	uint16				Width;			// Width of lightmap
	uint16				Height;			// Height of lightmap
	grFloat				MinU;
	grFloat				MinV;
	grFloat				MaxU;
	grFloat				MaxV;
	grFloat				StartU;			// Upper left u in worldspace
	grFloat				StartV;			// Upper left v in worldspace
	grVec3d				Tex2WorldVecU;
	grVec3d				Tex2WorldVecV;
	grVec3d				TexOrigin;

	int32				XStep;			// Lightmap step values (1:21:10 fixed)
	int32				YStep;
	int32				XScale;
	int32				YScale;

	uint8				Styles[4];		// 255 == No lightmap on that style
	uint8				*RGBData[GR_LIGHTMAP_MAX_STYLES];		// Normalized Lightdata for ((uint8*3)*(Width*Height))

	grTexture	*THandle;

	grVec3d				*Points;		// For cacheing out points

	uint8				Dynamic;		// Set everytime the lightmap gets new light data
} grBSPNode_Lightmap;

#define DRAWFACE_CALL_CB		(1<<0)

typedef struct grBSPNode_DrawFace
{
	uint8					TopSideFlags;	// Inherited from grBSP_TopSide TopSideFlags

	grBSP					*BSP;			

	grIndexPoly				*Poly;			// NumVerts is storeed in IndexPoly
	grTexVert				*TVerts;
	grFaceInfo_ArrayIndex	FaceInfoIndex;
	grPlaneArray_Index		PlaneIndex;
	grTexVec_ArrayIndex		TexVecIndex;
	uint8					NodeSide;

	uint32					Contents;

	grBSPNode_Lightmap		*Lightmap;		// If face has a lightmap, this will contain the lightmap data

	grObject				*PortalObject;	// If this face is a portal face, this will be valid (Not NULL)
	grXForm3d				*PortalXForm;	// XForm that describes the Src location of the portal before it is XFormed against the tru portal XForm

	grFloat					FixShiftU;		// How much UV's were shifted from worldspace locations
	grFloat					FixShiftV;

	grVec3d					Center;
	grFloat					Radius;

	uint32					DLights;		// Up to 32 lights can touch face, bit number of light
	uint32					DLightVisFrame;
	
	uint32					RecursionBits;

	grBrush_Face			*grBrushFace;	// If set, this face only touches one grBrushFace
} grBSPNode_DrawFace;

typedef struct grBSPNode_LeafSide
{
	grPlaneArray_Index	PlaneIndex;
} grBSPNode_LeafSide;

typedef struct grBSPNode_Leaf
{
	LinkNode			LN;

	grBSPNode			*Node;			// Node that leaf is on
	grBrush_Contents	BrushContents;	// Contents of all brushes in this leaf
	grBrush_Contents	Contents;		// Contents of leaf
	grBSP_Brush			*Brushes;		// Fragments of brushes in this leaf

	grBSPNode_Area		*Area;			// Area
		 
	int32				CurrentFrame;	// Flood filling...

	int32				NumDrawFaces;
	grpBSPNode_DrawFace	*DrawFaces;		// Array of pointers to draw faces that are inside this leaf 

	// Beveled Convex hull data
	int32				NumSides;		
	grBSPNode_LeafSide	*Sides;

} grBSPNode_Leaf;

typedef struct
{
	grBSPNode_Leaf		*Leaf;
} grBSPNode_AreaLeaf;

typedef struct
{
	grPoly				*Poly;
	grPlane				Plane;
	grBSPNode_Area		*Target;

} grBSPNode_AreaPortal;

typedef struct grBSPNode_Area
{
#ifdef AREA_DRAWFACE_TEST
	LinkNode				LN;
#endif
	uint32					RecursionBits;

	uint32					RefCount;
	
	int32					NumWorkAreaPortals;
	int32					NumAreaPortals;
	grBSPNode_AreaPortal	*AreaPortals;
	
	grArray					*LeafArray;		// An array of AreaLeafs

	grChain					*ObjectChain;

	grChain					*RenderDataList;  // The grRenderSectionData array - added by Krouer
	grChain					*FacesPerMaterialList; // The sort of faces per material - added by Krouer

#ifdef AREA_DRAWFACE_TEST
	List *					VisObjectList;

	int32					NumDrawFaces;
	grpBSPNode_DrawFace		*DrawFaces;
#endif
} grBSPNode_Area;

