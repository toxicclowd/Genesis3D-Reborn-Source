#ifndef ACTOR_PRIVATE_H
#define ACTOR_PRIVATE_H

#include "windows.h"

#ifdef __cplusplus
extern "C" {
#endif


typedef struct ActorObj
{
	grWorld			*World;
	grResourceMgr	*ResourceMgr;
	grEngine		*Engine;
	//grXForm3d		Xf;
	char			*ActorDefName;	
	int				RefCount;
	grBoolean		FillNormalActorRelative;
	grBoolean		CollisionExtBoxDisplay, RenderExtBoxDisplay;
	grExtBox		CollisionExtBox, RenderHintExtBox;
	float			ScaleX, ScaleY, ScaleZ;
	grBoolean		UseFillLight;
	grVec3d			FillLightNormal;
	grFloat			FillLightRed;
	grFloat			FillLightGreen;
	grFloat			FillLightBlue;
	grFloat			AmbientLightRed;
	grFloat			AmbientLightGreen;
	grFloat			AmbientLightBlue;
	grBoolean		UseAmbientLightFromFloor;
	int				MaximumDynamicLightsToUse;
	int				MaximumStaticLightsToUse;
	grBoolean		PerBoneLighting;
	grMotion		*Motion;
	char			**MotionList;
	int				MotionListSize;
	float			MotionTime;
	char			*MotionName;
	float			MotionTimeScale;
	char			**BoneList;
	int				BoneListSize;
	char			**MaterialList;
	char			**MaterialOverideList;
	char			**MaterialMapperList;
	int				MaterialListSize;
	grMaterialSpec	**MaterialOverideBitmap;
	int				MaterialCurrent;
	char			**LoadMaterialOverideList;
	int				LoadMaterialListSize;
	char			*LightReferenceBoneName;
	grBoolean		LoadedFromDisk;

	//Editor Brush support
	grLVertex	Vertex[8];

} ActorObj;

// Icestorm Begin: bone-extbox&name-structure for BoneCollisionChain
typedef struct grCollisionBone
{
	char		*BoneName;
	int			BoneIndex;
	grExtBox	*CurrExtBox;
	grExtBox	*PrevExtBox;
} grCollisionBone;
// Icestorm End

typedef struct grActor
{
	ActorObj *Object;		
	grXForm3d Xf;
	grBoolean CanFree;

	int32				 RefCount;				// this is the number of owners.
	grPuppet			*Puppet;
	grPose				*Pose;
	grActor_BlendingType BlendingType;
	grActor_Def			*ActorDefinition;		// actor definition this is an instance of
	
	grMotion			*CueMotion;
	grExtBox			CollisionExtBox;	
	int					BoundingBoxCenterBoneIndex;
	int					StepBoneIndex;			// used for single-bone motion optimization.
	void *				UserData;

	grExtBox			RenderHintExtBox;
	int					RenderHintExtBoxCenterBoneIndex;
	grBoolean			RenderHintExtBoxEnabled;
	
	// Incarnadine Begin
	grChain				*BoneCollisionChain;  // Added to allow for bone level collisions
	// Icestorm Begin : Faster linear coll.bone search
	char*				LastUsedCollisionBoneName;
	grChain_Link		*LastUsedCollisionBone;
	// Icestorm End
	uint32				CollisionFlags;  // Added to further control collisions
	char				*CollidedBone;
	// Incarnadine End

// @@
	grBoolean			needsRelighting; // flag indicating whether static lighting needs to be recomputed

	grBoolean			RenderNextTime;  //<! Next render pass flag

	CRITICAL_SECTION	RenderLock;

} grActor;


typedef struct grActor_Def
{
	grBody				*Body;
	grVFile *			 TextureFileContext;
	
	int32				 MotionCount;
	grMotion		   **MotionArray;

	int32				 RefCount;				// this is the number of owners.

	grActor_Def			*ValidityCheck;
} grActor_Def;

#ifdef __cplusplus
}
#endif

#endif
