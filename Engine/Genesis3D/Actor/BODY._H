#ifndef GR_BODY__H
#define GR_BODY__H 


#include "BaseType.h"
#include "Xform3d.h"
#include "Body.h"
#include "StrBlock.h"
#include "Bitmap.h"
#include "UVMap.h"
#include "grMaterial.h"


#ifdef __cplusplus
extern "C" {
#endif

#define GR_BODY_INDEX_MAX (0xEFFF)

#define GR_BODY_REALLY_BIG_NUMBER (9e9f)		// bigger than any skin point

#define GR_BODY_HIGHEST_LOD_MASK	( 1 << GR_BODY_HIGHEST_LOD )
#define GR_BODY_BBOX_LOD_MASK		( 1 << GR_BODY_NUMBER_OF_LOD ) // bounding box mask


typedef int16 grBody_Index;

typedef struct grBody_BlendData
{
	grVec3d			XPoint;
	grVec3d			Normal;
	grFloat			weight;
	grBody_Index	boneIndex;

}grBody_BlendData;

typedef struct grBody_XSkinVertex
{
	grVec3d			XPoint;
	grFloat			XU,XV;
	int8			LevelOfDetailMask;
	grBody_Index	BoneIndex;

	int16			nBlends; // = 0 if vertex isn't blended
	grBody_Index	bdaOffset; // offset into body's blend data array

} grBody_XSkinVertex;

typedef struct grBody_Normal
{
	grVec3d			Normal;
	int8			LevelOfDetailMask;
	grBody_Index	BoneIndex;

	int16			nBlends; // = 0 if vertex isn't blended
	grBody_Index	bdaOffset; // offset into body's blend data array

} grBody_Normal;

typedef struct grBody_Bone
{
	grVec3d			BoundingBoxMin;
	grVec3d			BoundingBoxMax;
	grXForm3d       AttachmentMatrix;
	grBody_Index	ParentBoneIndex;
} grBody_Bone;
		
typedef struct grBody_Triangle
{
	grBody_Index	VtxIndex[3];
	grBody_Index	NormalIndex[3];
	grBody_Index	MaterialIndex;
	//grBody_Index    FaceNormal;
} grBody_Triangle;
			
typedef struct grBody_TriangleList
{
	grBody_Index	  FaceCount;
	grBody_Triangle  *FaceArray;		// Sorted by MaterialIndex
} grBody_TriangleList;

typedef struct grBody_Material
{
	grMaterialSpec *MatSpec;
	grFloat Red,Green,Blue;
	grUVMapper Mapper;
} grBody_Material;

/*
typedef struct grBody_Weight
{
	grBody_Index	BoneIndex;
	grFloat			Weight;
} grBody_Weight;
*/

typedef struct grBody
{
	grVec3d				  BoundingBoxMin;
	grVec3d				  BoundingBoxMax;

	grBody_Index		  XSkinVertexCount;
	grBody_XSkinVertex	 *XSkinVertexArray;		// Sorted by BoneIndex

	grBody_Index		  SkinNormalCount;
	grBody_Normal		 *SkinNormalArray;

	int16				blendDataCount;
	grBody_BlendData	*blendDataArray;

	grBody_Index		  BoneCount;
	grBody_Bone			 *BoneArray;
	grStrBlock			 *BoneNames;

	grBody_Index		  MaterialCount;
	grBody_Material		 *MaterialArray;
	grStrBlock			 *MaterialNames;		

	int					  LevelsOfDetail;
	grBody_TriangleList	  SkinFaces[GR_BODY_NUMBER_OF_LOD];

	uint32 optFlags;
	
	grBody				 *IsValid;
} grBody;

#if defined(DEBUG) || !defined(NDEBUG)
GRAPI grBoolean GRCC grBody_SanityCheck(const grBody *B);
#endif



#ifdef __cplusplus
}
#endif

#endif
